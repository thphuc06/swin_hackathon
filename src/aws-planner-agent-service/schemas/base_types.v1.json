{
  "$id": "base_types.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specialist Base Types v1",
  "type": "object",
  "$defs": {
    "SchemaVersion": { "type": "string", "enum": ["v1"] },
    "ResultStatus": { "type": "string", "enum": ["ok", "partial", "error", "blocked"] },
    "Warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warn", "critical"], "default": "warn" }
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string" },
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "url": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "retrieved_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolCallSummary": {
      "type": "object",
      "required": ["tool_name", "status"],
      "properties": {
        "tool_name": { "type": "string" },
        "status": { "$ref": "#/$defs/ResultStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TraceInfo": {
      "type": "object",
      "required": ["trace_id", "request_id", "session_id", "agent_name", "tool_name", "schema_version"],
      "properties": {
        "trace_id": { "type": "string" },
        "request_id": { "type": "string" },
        "session_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "tool_name": { "type": "string" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "fallback_used": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "PolicyOutcome": {
      "type": "object",
      "properties": {
        "suitability": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "reason": { "type": "string" },
        "flags": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
