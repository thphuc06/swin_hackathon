{
  "$id": "run_planner_agent_v1.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run_planner_agent_v1 Input",
  "type": "object",
  "required": ["schema_version", "prompt", "request_id", "session_id", "trace_id"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "request_id": { "type": "string" },
    "session_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "prompt": { "type": "string" },
    "user_context": { "type": "object", "additionalProperties": true },
    "goals": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "session_summary": { "type": "string" },
    "policy_flags": { "type": "object", "additionalProperties": true },
    "hints": { "type": "object", "additionalProperties": true },
    "requested_outputs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
