{
  "$id": "base_types.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specialist Base Types v1",
  "type": "object",
  "$defs": {
    "SchemaVersion": { "type": "string", "enum": ["v1"] },
    "ResultStatus": { "type": "string", "enum": ["ok", "partial", "error", "blocked"] },
    "Actor": {
      "type": "object",
      "required": ["actor_id", "user_id", "tenant_id", "scopes"],
      "properties": {
        "actor_id": { "type": "string" },
        "user_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Correlation": {
      "type": "object",
      "required": ["session_id", "request_id", "trace_id", "parent_request_id"],
      "properties": {
        "session_id": { "type": "string" },
        "request_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "parent_request_id": { "type": "string" },
        "request_timestamp": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "required": ["prompt", "intent", "policy_flags", "user_context", "goals", "session_summary"],
      "properties": {
        "prompt": { "type": "string" },
        "intent": { "type": "string" },
        "policy_flags": { "type": "object", "additionalProperties": true },
        "user_context": { "type": "object", "additionalProperties": true },
        "goals": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "session_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Routing": {
      "type": "object",
      "required": ["specialist_id", "tool_name"],
      "properties": {
        "specialist_id": { "type": "string" },
        "tool_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warn", "critical"], "default": "warn" }
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string" },
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "url": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "retrieved_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolCallSummary": {
      "type": "object",
      "required": ["tool_name", "status"],
      "properties": {
        "tool_name": { "type": "string" },
        "status": { "$ref": "#/$defs/ResultStatus" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "PolicyOutcome": {
      "type": "object",
      "properties": {
        "suitability": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "reason": { "type": "string" },
        "flags": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
