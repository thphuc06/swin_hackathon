{
  "$id": "stock_result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockResult v1",
  "type": "object",
  "required": ["summary"],
  "properties": {
    "summary": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "action", "rationale"],
        "properties": {
          "ticker": { "type": "string" },
          "action": { "type": "string", "enum": ["buy", "hold", "avoid"] },
          "rationale": { "type": "string" },
          "risk_level": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "rationale"],
        "properties": {
          "ticker": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "suitability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "unknown"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "market_notes": { "type": "array", "items": { "type": "string" } },
    "citations": { "type": "array", "items": { "$ref": "base_types.v1.json#/$defs/Citation" } },
    "warnings": { "type": "array", "items": { "$ref": "base_types.v1.json#/$defs/Warning" } }
  },
  "additionalProperties": false
}
