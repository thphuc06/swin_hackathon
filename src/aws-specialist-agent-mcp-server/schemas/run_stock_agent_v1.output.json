{
  "$id": "run_stock_agent_v1.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run_stock_agent_v1 Output",
  "type": "object",
  "required": ["schema_version", "agent_id", "agent_version", "status", "correlation", "result"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "agent_id": { "const": "stock" },
    "agent_version": { "type": "string" },
    "tool_name": { "const": "run_stock_agent_v1" },
    "status": { "type": "string", "enum": ["ok", "partial", "error", "blocked"] },
    "correlation": {
      "type": "object",
      "required": ["session_id", "request_id", "trace_id", "parent_request_id"],
      "properties": {
        "session_id": { "type": "string" },
        "request_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "parent_request_id": { "type": "string" },
        "request_timestamp": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": { "type": "string" },
    "result": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ticker", "action", "rationale"],
            "properties": {
              "ticker": { "type": "string" },
              "action": { "type": "string", "enum": ["buy", "hold", "avoid"] },
              "rationale": { "type": "string" },
              "risk_level": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ticker", "rationale"],
            "properties": {
              "ticker": { "type": "string" },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "suitability": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "warn", "fail", "unknown"] },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "market_notes": { "type": "array", "items": { "type": "string" } },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id"],
            "properties": {
              "source_id": { "type": "string" },
              "title": { "type": "string" },
              "snippet": { "type": "string" },
              "url": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "retrieved_at": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["info", "warn", "critical"], "default": "warn" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "suitability": { "type": "string", "enum": ["pass", "warn", "fail", "unknown"] },
        "reason": { "type": "string" },
        "flags": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "critical"], "default": "warn" }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
