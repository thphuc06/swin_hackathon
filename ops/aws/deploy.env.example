# Deploy-time bindings for ops/aws/*.ps1
# Copy into your shell session or a local-only env file before running deploys.

DEPLOY_APP_ENV=staging
DEPLOY_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
DEPLOY_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
DEPLOY_COGNITO_ALLOWED_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyy
DEPLOY_COGNITO_SERVICE_CLIENT_IDS=yyyyyyyyyyyyyyyyyyyyyyyyyy

DEPLOY_BACKEND_SERVICE_NAME=jars-backend
DEPLOY_BACKEND_IMAGE_REPO_URI=<account-id>.dkr.ecr.us-east-1.amazonaws.com/jars-backend
DEPLOY_BACKEND_API_BASE=http://<alb-dns-name>
DEPLOY_ECS_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/jars-staging-ecs-execution
DEPLOY_BACKEND_TASK_ROLE_ARN=arn:aws:iam::<account-id>:role/jars-staging-backend-task
DEPLOY_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account-id>:runtime/<orchestrator-runtime-id>

DEPLOY_ORCHESTRATOR_RUNTIME_ROLE_ARN=arn:aws:iam::<account-id>:role/<agentcore-runtime-role>
DEPLOY_SPECIALIST_RUNTIME_ROLE_ARN=arn:aws:iam::<account-id>:role/<agentcore-runtime-role>

DEPLOY_GATEWAY_NAME=financial-advisory-gw-specialist
DEPLOY_GATEWAY_ROLE_ARN=arn:aws:iam::<account-id>:role/<gateway-service-role>
DEPLOY_GATEWAY_OAUTH_PROVIDER_ARN=arn:aws:bedrock-agentcore:us-east-1:<account-id>:token-vault/default/oauth2credentialprovider/<provider-id>

DEPLOY_POLICY_ALLOWED_TOOLS=spend_analytics_v1,cashflow_forecast_v1,jar_allocation_suggest_v1,anomaly_signals_v1,risk_profile_non_investment_v1,recurring_cashflow_detect_v1,goal_feasibility_v1,what_if_scenario_v1,run_stock_agent_v1,suitability_guard_v1
DEPLOY_GATEWAY_TIMEOUT_SECONDS=90

DEPLOY_SUPABASE_URL=https://<project>.supabase.co
DEPLOY_SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optional stock compatibility path for specialist MCP
DEPLOY_STOCK_AGENT_EXTERNAL_ENABLED=false
DEPLOY_STOCK_AGENT_EXTERNAL_URL=
# DEPLOY_STOCK_AGENT_EXTERNAL_BASE_URL=
# DEPLOY_STOCK_AGENT_EXTERNAL_ENDPOINT_PATH=/ask
DEPLOY_STOCK_AGENT_EXTERNAL_MODEL_PROVIDER=bedrock
DEPLOY_STOCK_AGENT_EXTERNAL_MODEL=bedrock:us.anthropic.claude-sonnet-4-20250514-v1:0
DEPLOY_STOCK_AGENT_EXTERNAL_AUTH_TOKEN=
DEPLOY_STOCK_AGENT_EXTERNAL_TIMEOUT_SECONDS=10
DEPLOY_STOCK_AGENT_EXTERNAL_CONNECT_TIMEOUT_SECONDS=2
DEPLOY_STOCK_AGENT_EXTERNAL_READ_TIMEOUT_SECONDS=8
